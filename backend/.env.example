ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cheaper model used for background topic-mastery grading
MASTERY_MODEL=claude-haiku-5-5

# REQUIRED: the server refuses to start without a strong, private secret.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

FRONTEND_ORIGIN=http://localhost:3000

# Optional: HuggingFace mirror for the embedding model download, useful when
# huggingface.co is unreachable (e.g. HF_ENDPOINT=https://hf-mirror.com)
# HF_ENDPOINT=

# Optional: Resend API key so forgot-password emails actually send
# RESEND_API_KEY=
